#!/bin/sh
# ga-bootstrap — first-boot orchestrator that brings up ga_manager.
#
# Runs once after `hassio-supervisor.service` is healthy. Performs the
# minimum bootstrap steps needed for ga_manager to take over and converge
# the rest of the system:
#
#   1. Wait until Supervisor responds.
#   2. Add the public `vibe_addons` add-on store (idempotent).
#   3. Write GHCR pull credentials into Supervisor's auth registry
#      (= unblocks pulling the private ga_manager addon image).
#   4. Install + start the `ga_manager` add-on.
#   5. Touch the marker file so this service is a no-op on future boots.
#
# Everything beyond this — DNS, watchdog, addon options, per-device
# secrets, bundle expectation, dashboard, etc. — is the responsibility
# of `ga_manager` converge. Keep ga-bootstrap tiny.
#
# Exit codes:
#   0 — bootstrap finished cleanly OR marker already present (no-op).
#   1 — Supervisor never came up within SUPERVISOR_WAIT_S seconds.
#   2 — Adding the vibe_addons store failed (network / supervisor error).
#   3 — Writing GHCR credentials failed.
#   4 — `ha addons install ga_manager` failed, or `addons start` never
#       succeeded within GM_START_MAX_S (retried in-run on "not ready").
#   5 — jq itself failed while checking the store list (program error /
#       jq not runnable / mktemp failed): a broken image, NOT retryable —
#       distinct from 2 (store did not register after all retries).
#   6 — ga_manager container not found under app_<slug> / addon_<slug>
#       (also after the visibility wait), or not inspectable. Terminal.
#   7 — docker.sock still unbound after restart, or the restart never
#       succeeded within GM_RESTART_MAX_S. Terminal for this run; systemd
#       retries (Restart=on-failure) and the marker is NOT written.
#   8 — Supervisor never reported `ha info` .data.state == running within
#       the readiness wait (before install / before first start).
#       Transient class, retried by systemd.
#   9 — the protected=false security POST was never accepted within
#       GM_POST_MAX_S. ga_manager is NOT started (a protected first
#       container would have no docker.sock). Retried by systemd.
#
# Env overrides (read from /etc/ga/ga-bootstrap.conf if present, then
# from the environment — env wins):
#   MARKER                    default /mnt/data/.ga-bootstrapped
#   SUPERVISOR_WAIT_S         default 1200  (cold boot eMMC is slow)
#   SUPERVISOR_POLL_INTERVAL  default 5
#   GA_MANAGER_SLUG           default 99f1cad4_ga_manager
#   VIBE_STORE_URL            default https://github.com/greenautarky/vibe_addons
#   GHCR_CREDS_FILE           default /etc/ga/ghcr-creds.json
#                              {"ghcr.io":{"username":"…","password":"…"}}
#   HA_CORE_WAIT_S            default 600   (HA Core cold-start can be slow)
#   HA_CORE_POLL_INTERVAL     default 10
#   JQ_CLI                    default jq    (path / fallback for the json parser)
#   DOCKER_CLI                default docker
#   SLEEP_CMD                 default sleep (test seam for the step-3 waits)
#   BG_BUDGET_S               default 1440  (whole-run budget; every step-3
#                              wait is cut off at start+BG_BUDGET_S, kept
#                              below the unit's TimeoutStartSec=1500)
#   GM_READY_WAIT_S / GM_READY_STEP_S      default 600 / 10 (ha info running;
#                              ONE budget shared by both waits of a run)
#   GM_POST_MAX_S / GM_POST_STEP_S         default 210 / 15 (protected POST)
#   GM_START_MAX_S / GM_START_STEP_S       default 300 / 15 (addons start)
#   GM_VISIBLE_WAIT_S / GM_VISIBLE_STEP_S  default 60 / 5   (container visible)
#   GM_RESTART_MAX_S / GM_RESTART_STEP_S   default 600 / 30 (restart, 21 tries)
#
# Test seam: every external binary is invoked via a variable so the
# pytest harness can replace `ha` / `docker` with a shim on $PATH and
# `BG_DRY_RUN=1` short-circuits the marker write.
#
# Step 0a (auto_update=false) goes via the Supervisor API, not direct
# edit of updater.json — the OS-side ga-ha-init learned the hard way
# (KIB-SON-31 first boot 2026-05-27) that Supervisor rewrites
# updater.json on the next refresh, clobbering any jq-style direct edit.
# `ha supervisor options --auto-update=false` mutates Supervisor's
# in-memory state and persists. Order matters: run Step 0a *before*
# installing addons so even the first ga_manager addon install can't
# trigger an auto-update side effect.
#
# Step 6 (wait for HA Core ready) absorbs ga-ha-init's responsibilities
# so ga-bootstrap exits only once the device is fully reachable. The
# OS-side ga-ha-init.service is removed in the matching ha-operating-
# system PR.

set -eu

# --- config -----------------------------------------------------------
CONF=/etc/ga/ga-bootstrap.conf
if [ -f "$CONF" ]; then
  # shellcheck disable=SC1090  # runtime-resolved path is intentional
  . "$CONF"
fi

MARKER="${MARKER:-/mnt/data/.ga-bootstrapped}"
SUPERVISOR_WAIT_S="${SUPERVISOR_WAIT_S:-1200}"
SUPERVISOR_POLL_INTERVAL="${SUPERVISOR_POLL_INTERVAL:-5}"
HA_CORE_WAIT_S="${HA_CORE_WAIT_S:-600}"
HA_CORE_POLL_INTERVAL="${HA_CORE_POLL_INTERVAL:-10}"
GA_MANAGER_SLUG="${GA_MANAGER_SLUG:-99f1cad4_ga_manager}"
VIBE_STORE_URL="${VIBE_STORE_URL:-https://github.com/greenautarky/vibe_addons}"
GHCR_CREDS_FILE="${GHCR_CREDS_FILE:-/etc/ga/ghcr-creds.json}"
# Host-side add-on data roots. Supervisor 2026.10 renamed
# /mnt/data/supervisor/addons to .../apps; older Supervisors use addons.
# Both are searched, apps first (Odoo #1610).
SUPERVISOR_DATA_ROOTS="${SUPERVISOR_DATA_ROOTS:-/mnt/data/supervisor/apps/data /mnt/data/supervisor/addons/data}"
HA_CLI="${HA_CLI:-ha}"
JQ_CLI="${JQ_CLI:-jq}"
DOCKER_CLI="${DOCKER_CLI:-docker}"
SLEEP_CMD="${SLEEP_CMD:-sleep}"
T0=$(date +%s)
BG_BUDGET_S="${BG_BUDGET_S:-1440}"
T_END=$(( T0 + BG_BUDGET_S ))
GM_READY_WAIT_S="${GM_READY_WAIT_S:-600}"
READY_SPENT_S=0   # seconds already slept in readiness waits (shared budget)
GM_READY_STEP_S="${GM_READY_STEP_S:-10}"
GM_POST_MAX_S="${GM_POST_MAX_S:-210}"
GM_POST_STEP_S="${GM_POST_STEP_S:-15}"
GM_START_MAX_S="${GM_START_MAX_S:-300}"
GM_START_STEP_S="${GM_START_STEP_S:-15}"
GM_VISIBLE_WAIT_S="${GM_VISIBLE_WAIT_S:-60}"
GM_VISIBLE_STEP_S="${GM_VISIBLE_STEP_S:-5}"
GM_RESTART_MAX_S="${GM_RESTART_MAX_S:-600}"
GM_RESTART_STEP_S="${GM_RESTART_STEP_S:-30}"
DRY_RUN="${BG_DRY_RUN:-0}"
# Exponential-backoff sequence for the two retry loops (store-add +
# addons-install). Space-separated pre-sleep seconds. Tests override
# this to short delays so the suite finishes in <30 s; production
# default is the field-validated 0/10/30/60/120/240 (~8 min budget).
BACKOFF_SEQUENCE="${BACKOFF_SEQUENCE:-0 10 30 60 120 240}"

log() { printf '[ga-bootstrap] %s\n' "$*"; }
fail() { log "ERROR: $1"; exit "${2:-1}"; }

# retry_cmd <label> <max_s> <step_s> <cmd...>
# Runs the command up to max_s/step_s+1 times (3 when step is 0 — test
# shortcut), sleeping step_s between tries via $SLEEP_CMD, and gives up early
# when the whole-run deadline T_END passes. Returns 0 on first success.
# Last output is left in $_rc_out.
retry_cmd() {
  _rc_label=$1; _rc_max=$2; _rc_step=$3; shift 3
  if [ "$_rc_step" -gt 0 ]; then
    _rc_n=$(( _rc_max / _rc_step + 1 ))
  else
    _rc_n=3
  fi
  _rc_i=0
  while [ "$_rc_i" -lt "$_rc_n" ]; do
    _rc_i=$(( _rc_i + 1 ))
    if _rc_out=$("$@" 2>&1); then
      return 0
    fi
    log "$_rc_label failed (attempt $_rc_i/$_rc_n): $_rc_out"
    [ "$_rc_i" -lt "$_rc_n" ] || break
    if [ "$(date +%s)" -ge "$T_END" ]; then
      log "$_rc_label: whole-run budget (${BG_BUDGET_S}s) exhausted"
      break
    fi
    "$SLEEP_CMD" "$_rc_step"
  done
  return 1
}

# Supervisor readiness is `ha info` .data.state == running. (`ha supervisor
# info` has no state field and answers ok during startup — it gates nothing.)
ha_state_running() {
  _st=$("$HA_CLI" info --no-progress --raw-json 2>/dev/null \
          | "$JQ_CLI" -r '.data.state // ""' 2>/dev/null) || return 1
  [ "$_st" = "running" ] || { echo "state=${_st:-none}"; return 1; }
}
# The two waits (before install, before first start) share ONE budget of
# GM_READY_WAIT_S: the second only gets what the first left, so a single run
# never spends 2x the bound. Spent time is the slept seconds ($_rc_i tries).
wait_ready() {
  _wr_left=$(( GM_READY_WAIT_S - READY_SPENT_S ))
  [ "$_wr_left" -ge 0 ] || _wr_left=0
  log "waiting for Supervisor state=running ($1, up to ${_wr_left}s of the ${GM_READY_WAIT_S}s shared budget)"
  _wr_rc=0
  retry_cmd "Supervisor readiness" "$_wr_left" "$GM_READY_STEP_S" ha_state_running || _wr_rc=1
  READY_SPENT_S=$(( READY_SPENT_S + (_rc_i - 1) * GM_READY_STEP_S ))
  [ "$_wr_rc" -eq 0 ] || fail "Supervisor never reported state=running ($1)" 8
}

# --- 0. marker check (idempotent) -------------------------------------
if [ -f "$MARKER" ]; then
  log "marker $MARKER present — bootstrap already completed, exiting 0"
  exit 0
fi

# --- 1. wait for supervisor -------------------------------------------
log "waiting for Supervisor (up to ${SUPERVISOR_WAIT_S}s)"
deadline=$(( $(date +%s) + SUPERVISOR_WAIT_S ))
sup_info=""
while :; do
  sup_info=$("$HA_CLI" supervisor info --raw-json 2>/dev/null || true)
  if printf '%s' "$sup_info" | grep -q '"result":"ok"'; then
    log "Supervisor ready"
    break
  fi
  if [ "$(date +%s)" -ge "$deadline" ]; then
    fail "Supervisor never reported ok within ${SUPERVISOR_WAIT_S}s" 1
  fi
  sleep "$SUPERVISOR_POLL_INTERVAL"
done

# --- 1a. disable Supervisor auto-update -------------------------------
# Why: fleet devices must not auto-update Supervisor — the rollout is
# operator-controlled via push-ota.sh + RAUC bundle promotion. Auto-update
# bypasses that and has caused incidents (incident_ga1_hang_2026_05_06 —
# Supervisor auto-updated hassio_cli mid-run and triggered an eMMC stall).
#
# Go via the Supervisor API even though we have jq — direct jq on
# /mnt/data/supervisor/updater.json silently fails: Supervisor caches
# auto_update in memory and rewrites the file on the next refresh,
# clobbering the edit (observed on KIB-SON-31, 2026-05-27). The CLI's
# `supervisor options --auto-update=false` mutates the in-memory state
# so the change actually sticks.
# Reuse the supervisor-info response we just captured in the wait loop
# above — one fewer API round-trip. NB: do NOT use jq's `// "missing"`
# here — `//` triggers on null OR false, so a correct
# `auto_update: false` reading would report "missing" and we'd re-issue
# the options call every boot. Read the raw bool with tostring instead;
# a genuinely missing field shows up as "null" and we treat that as
# "needs setting".
current_auto=$(printf '%s' "$sup_info" \
                  | "$JQ_CLI" -r '.data.auto_update | tostring' 2>/dev/null || echo null)
if [ "$current_auto" = "false" ]; then
  log "Supervisor auto_update=false (already set)"
else
  log "Supervisor auto_update was $current_auto — setting false via API"
  if ! "$HA_CLI" supervisor options --auto-update=false --no-progress >/dev/null 2>&1; then
    # NON-FATAL: if Supervisor's API rejects the call here, the device
    # is still usable and ga_manager converge step 8 will retry every
    # 30 s. We log a warning, do NOT bail — exiting non-zero here
    # would prevent the rest of bootstrap from running.
    log "WARN: Supervisor rejected auto-update=false — converge will retry"
  fi
fi

# --- 2. add vibe_addons store -----------------------------------------
# `ha store add` is a misleading API: it returns 0 once Supervisor accepts
# the addition into its config, but the actual `git clone` happens
# asynchronously in the background, and can fail with "invalid HEAD" or
# exit 128 within the first 1-2 minutes (Supervisor + git race on slow
# eMMC / cold network). A 0 exit code is NOT trust-worthy on its own.
#
# We therefore loop with an exponential-backoff (0/10/30/60/120/240 s
# pre-sleep, ~8 min total budget) AND verify after each call that the
# repo actually shows up in `ha store repositories --raw-json`.
#
# This pattern is identical to the rootfs ga-bootstrap retained until
# BOSv1.2.4 — proven against transient supervisor-git-clone races in the
# field. The build-test BS-RETRY-01/02 enforces both exist.

# Return codes (never conflate them — a jq PROGRAM error used to look exactly
# like "not present" and made bootstrap retry-loop silently, Odoo #1610):
#   0 repo is listed        1 not listed / transient (retryable, WARN logged)
#   2 ERROR: the jq PROGRAM failed on valid JSON, or jq cannot run at all
#     (rc 126/127), or mktemp failed. Logged at error level with rc + jq's
#     stderr; the caller must NOT retry and exits with code 5.
# Transient things are rc 1 with a WARN, never fatal: `ha` failing, an empty /
# non-JSON reply (HTML 502, truncated JSON, text — jq 1.7 answers rc 5 for
# those too, so input parsing is checked in its OWN jq call first), and valid
# JSON of an unexpected shape. The program itself is total over JSON types, so
# a program failure can only mean a broken jq/program. There is no pipefail, so
# ha and jq run as separate steps; `ha ... | jq` would hide ha's exit status.
addon_repo_present() {
  # ha store repositories --raw-json lists configured repos under .data
  # (an object with .repositories, or - as the Supervisor API returns it - a
  # plain list). Source URLs are compared normalised: case, scheme, trailing
  # slashes and a trailing ".git" are ignored (Odoo #1610 round 2).
  ha_rc=0
  repos=$("$HA_CLI" store repositories --no-progress --raw-json 2>/dev/null) || ha_rc=$?
  if [ "$ha_rc" -ne 0 ]; then
    log "WARN: 'ha store repositories' failed (rc=$ha_rc) — treating the repo as not listed"
    return 1
  fi
  jq_err=$(mktemp -t ga-bootstrap-jq.XXXXXX) || {
    log "ERROR: mktemp failed in addon_repo_present — cannot capture jq stderr"
    return 2
  }
  # Step 1: is the reply JSON at all? (a failure here is the INPUT, transient)
  jq_rc=0
  printf '%s' "$repos" | "$JQ_CLI" -e 'type' >/dev/null 2>"$jq_err" || jq_rc=$?
  jq_msg=$(cat "$jq_err" 2>/dev/null || true)
  if [ "$jq_rc" -eq 126 ] || [ "$jq_rc" -eq 127 ]; then
    rm -f "$jq_err"
    log "ERROR: jq cannot be executed in addon_repo_present (rc=$jq_rc): $jq_msg"
    return 2
  elif [ "$jq_rc" -ne 0 ]; then
    rm -f "$jq_err"
    log "WARN: 'ha store repositories' reply is not valid JSON (jq rc=$jq_rc): ${jq_msg:-empty reply} — treating the repo as not listed"
    return 1
  fi
  # Step 2: the real program. Prints true / false / shape:<what was wrong>.
  # shellcheck disable=SC2016  # $url is a JQ variable bound by --arg.
  jq_out=$(printf '%s' "$repos" | "$JQ_CLI" -r --arg url "$VIBE_STORE_URL" '
        # NO regex builtins here (sub/test/match/capture/scan/gsub/splits):
        # the shipped jq is built WITHOUT oniguruma, so any of them exits 5
        # and this function would never return true (rc7 gate, Odoo #1610).
        # tests/test_jq_lint.py enforces it; CI also runs pytest with such a jq.
        def scheme_ok: length > 0
                       and (.[0] | . >= 97 and . <= 122)
                       and all(.[1:][]; (. >= 97 and . <= 122) or (. >= 48 and . <= 57)
                                        or . == 43 or . == 45 or . == 46);
        def strip_scheme: split("://") as $p
                  | if ($p | length) > 1 and ($p[0] | explode | scheme_ok)
                    then ($p[1:] | join("://")) else . end;
        def rtrim_slash: until(endswith("/") | not; .[:-1]);
        def norm: ascii_downcase | strip_scheme | rtrim_slash
                  | if endswith(".git") then .[:-4] else . end | rtrim_slash;
        # total over JSON shapes: every step is guarded on type
        def repo_list:
          if type == "array" then .
          elif type == "object" then
            (if (.data | type) == "object" and (.data.repositories | type) == "array" then .data.repositories
             elif (.repositories | type) == "array" then .repositories
             elif (.data | type) == "array" then .data
             else null end)
          else null end;
        . as $in
        | (repo_list) as $l
        | if $l == null then "shape:top=\($in | type) data=\(if ($in | type) == "object" then ($in.data | type) else "n/a" end)"
          else ($l | map(if type == "object" and (.source | type) == "string" then (.source | norm) else "" end)
                   | any(. == ($url | norm)))
          end
      ' 2>"$jq_err") && jq_rc=0 || jq_rc=$?
  jq_msg=$(cat "$jq_err" 2>/dev/null || true)
  rm -f "$jq_err"
  if [ "$jq_rc" -ne 0 ]; then
    log "ERROR: jq failed in addon_repo_present (rc=$jq_rc): $jq_msg"
    return 2
  fi
  case "$jq_out" in
    true) return 0 ;;
    false) return 1 ;;
    shape:*)
      log "WARN: 'ha store repositories' reply has an unexpected JSON shape (${jq_out#shape:}) — treating the repo as not listed"
      return 1 ;;
    *"
"*)
      # Several concatenated JSON documents: each prints its own line. A doubled
      # or concatenated reply is a transient oddity of the reply, not a program
      # error — retry it like any other malformed reply (re-review of #11).
      log "WARN: 'ha store repositories' reply holds several JSON documents — treating the repo as not listed"
      return 1 ;;
    *)
      log "ERROR: jq in addon_repo_present printed unexpected output: $jq_out"
      return 2 ;;
  esac
}

log "adding vibe_addons store ($VIBE_STORE_URL) — with retry"
store_added=0
for pre_sleep in $BACKOFF_SEQUENCE; do
  if [ "$pre_sleep" -gt 0 ]; then
    log "waiting ${pre_sleep}s before retry..."
    "$HA_CLI" store reload --no-progress >/dev/null 2>&1 || true
    sleep "$pre_sleep"
  fi
  # Capture stderr+stdout so we can distinguish "already added" from
  # real failures. Exit code alone is insufficient — supervisor returns
  # non-zero for both "already added" and transient clone failure.
  store_log=$(mktemp -t ga-bootstrap-store.XXXXXX)
  "$HA_CLI" --no-progress store add "$VIBE_STORE_URL" >"$store_log" 2>&1 && rc=0 || rc=$?
  cat "$store_log"
  # Capture output BEFORE removing the file — the "already" grep was
  # previously running against a deleted file, so the idempotent path
  # never fired and ga-bootstrap retried forever on a re-bootstrap.
  store_output=$(cat "$store_log" 2>/dev/null || true)
  rm -f "$store_log"
  # Decide by "repo present" (the store list), never by the wording of the
  # reply: Supervisor 2026.10 answers a re-add of a registered store with
  # HTTP 409 whose CLI text no longer contains "already" (measured on a
  # canary, Odoo #1610), so the old grep looped forever and never reached
  # step 3a. A 409 counts as "registered" ONLY if the repo is listed.
  present_rc=0
  addon_repo_present || present_rc=$?
  if [ "$present_rc" -eq 2 ]; then
    fail "jq error while checking the store list (see ERROR above) — not retrying" 5
  fi
  if [ "$present_rc" -eq 0 ]; then
    if [ "$rc" -ne 0 ]; then
      log "store add returned $rc but the repo is listed — store already registered"
    fi
    log "vibe_addons store registered + verified"
    store_added=1
    "$HA_CLI" store reload --no-progress >/dev/null 2>&1 || true
    break
  elif [ "$rc" -eq 0 ]; then
    log "store add returned ok but repo not yet visible — retrying"
  elif printf '%s' "$store_output" | grep -q -i 'blocked from execution'; then
    # NOT a transient race — a Supervisor JOB CONDITION, and retrying it for
    # eight minutes changes nothing. The one that bites here is
    # `supervisor_updated`: Supervisor refuses StoreManager work whenever it
    # considers itself out of date, i.e. whenever the baked version is older
    # than the channel advertises.
    #
    # Measured on K31 2026-07-30. The build was baking supervisor 2025.11.4.5
    # from a stale branch while devices poll 2025.11.4.6, so EVERY freshly
    # flashed device hit this: no store, no add-ons, no ga_manager, no
    # provisioning — and no error anywhere except this log. The device boots,
    # answers on serial, looks healthy, and is inert.
    #
    # ha-operating-system#295 removes the cause. This removes the dependency
    # on that cause staying fixed: a device that cannot register its store is
    # useless, and that must not hinge on a version comparison being perfect.
    #
    # Trade-off, deliberate: `jobs options --ignore-conditions` is persistent
    # Supervisor state, so the condition stays ignored afterwards. That is the
    # cheaper failure — an unprovisionable device cannot be fixed remotely at
    # all. Explicitly NOT `supervisor update`, which triggers the armv7 Core
    # image flip (2026-06-23).
    log "store add BLOCKED by a supervisor job condition — not transient, lifting it"
    printf '%s' "$store_output" | head -2 | while IFS= read -r l; do log "  supervisor: $l"; done
    if "$HA_CLI" jobs options --ignore-conditions supervisor_updated --no-progress >/dev/null 2>&1; then
      log "lifted supervisor_updated condition — retrying store add immediately"
      present_rc=1
      if "$HA_CLI" --no-progress store add "$VIBE_STORE_URL" >/dev/null 2>&1; then
        present_rc=0
        addon_repo_present || present_rc=$?
        [ "$present_rc" -ne 2 ] || fail "jq error while checking the store list (see ERROR above) — not retrying" 5
      fi
      if [ "$present_rc" -eq 0 ]; then
        log "vibe_addons store registered + verified (after lifting the condition)"
        store_added=1
        "$HA_CLI" store reload --no-progress >/dev/null 2>&1 || true
        break
      fi
      log "still not registered after lifting — falling through to backoff"
    else
      log "WARN: could not lift the job condition — the store will stay blocked"
    fi
  else
    log "WARN: store add returned $rc and the repo is NOT listed — unexpected, retrying: $(printf '%s' "$store_output" | head -1)"
  fi
done
[ "$store_added" -eq 1 ] || fail "vibe_addons store failed to register after 6 attempts (~8 min)" 2

# --- 3. write GHCR pull creds -----------------------------------------
# Without these, the private ga_manager addon image pull would 401.
# Sources tried in priority order — first one present wins:
#
#   1. $GHCR_CREDS_FILE (env / EnvironmentFile override) — explicit operator path
#   2. /etc/ga/ghcr-creds.json — OS-bake-time path (= original v1.2.x convention)
#   3. /mnt/data/supervisor/{apps,addons}/data/*_ga_manager/ghcr-creds.json — glob over
#      ga_manager's addon-private dir, where ga_manager 0.27.1+ writes via
#      its /data/ mount. The wildcard before "_ga_manager" tolerates slug
#      renames (= today 99f1cad4_ga_manager, but a slug bump wouldn't
#      break this script). Survives OTA + NOT readable by any other addon.
#   4. /mnt/data/ghcr-creds.json — root-only persistent fallback. Used by
#      `tests/ga_tests/lib/provision_test_fixture.sh` on bench devices.
#
# /share/ga/ghcr-creds.json was RETIRED in 1.2.5 (= same release as
# ga_manager 0.27.1) — that path is addon-readable by any addon with
# `map: [share:rw]` (= Z2M, Mosquitto, many community ones). See
# greenautarky-onboarding v1.0.1 + v1.0.3 sister moves for the same
# threat-model fix.
#
# Why the fallback chain (added v1.2.4): /etc/ is a RO squashfs on HAOS,
# baked at OS image time. After a RAUC slot-switch the new squashfs has
# no /etc/ga/ghcr-creds.json — the file belonged to the previous build.
# Pre-1.2.4 the script exited 3 here; the whole user-facing cascade
# (ga_manager → converge → custom_components → integration) stayed
# blocked. The fallback paths let ga-bootstrap self-recover post-OTA as
# long as fleet-manager has dispatched its ghcr-creds-push job (= which
# cred_autopush.py does automatically on new-device registration).
GHCR_CREDS_FILE_FOUND=""
# Round 1: literal paths (= cheap, common case)
for candidate in \
    "$GHCR_CREDS_FILE" \
    "/etc/ga/ghcr-creds.json" \
    "/mnt/data/ghcr-creds.json"; do
  if [ -n "$candidate" ] && [ -f "$candidate" ]; then
    GHCR_CREDS_FILE_FOUND="$candidate"
    break
  fi
done
# Round 2: glob ga_manager's addon-private path. Only if no literal hit.
# The slug pattern *_ga_manager covers today's 99f1cad4_ga_manager and
# any future re-build of the addon under a different installation slug.
if [ -z "$GHCR_CREDS_FILE_FOUND" ]; then
  for _root in $SUPERVISOR_DATA_ROOTS; do
    for candidate in "$_root"/*_ga_manager/ghcr-creds.json; do
      if [ -f "$candidate" ]; then
        GHCR_CREDS_FILE_FOUND="$candidate"
        break 2
      fi
    done
  done
fi
if [ -z "$GHCR_CREDS_FILE_FOUND" ]; then
  fail "GHCR creds missing at all candidate paths (env / /etc/ga/ / /mnt/data/ / addon-private /data/) — provisioner did not deliver creds AND fleet-manager has not pushed any" 3
fi
[ "$GHCR_CREDS_FILE_FOUND" != "$GHCR_CREDS_FILE" ] && \
  log "GHCR creds found via fallback: $GHCR_CREDS_FILE_FOUND (env/default was $GHCR_CREDS_FILE)"
log "registering GHCR credentials with Supervisor"
# The legacy `-f <file>` flag on `ha docker registries` was removed in a
# pre-v1.2 Supervisor CLI bump (= raises 'unknown shorthand flag: f' on
# Supervisor 2025.11.4.5). We now parse the JSON ourselves and pass
# host/user/pw via the CLI's `add` subcommand which is the documented
# non-interactive path.
# JSON format we accept (= what ga_manager writes + ga-flasher delivers):
#   {"<host>": {"username": "<u>", "password": "<p>"}, ...}
creds_registered=0
for host in $("$JQ_CLI" -r 'keys[]' "$GHCR_CREDS_FILE_FOUND" 2>/dev/null); do
  # shellcheck disable=SC2016  # $h is a JQ variable bound by --arg above.
  u=$("$JQ_CLI" -r --arg h "$host" '.[$h].username' "$GHCR_CREDS_FILE_FOUND")
  # shellcheck disable=SC2016  # ditto
  p=$("$JQ_CLI" -r --arg h "$host" '.[$h].password' "$GHCR_CREDS_FILE_FOUND")
  if [ -z "$u" ] || [ "$u" = "null" ] || [ -z "$p" ] || [ "$p" = "null" ]; then
    log "WARN: $host entry missing username/password in $GHCR_CREDS_FILE_FOUND — skipping"
    continue
  fi
  if "$HA_CLI" --no-progress docker registries add "$host" \
       --username "$u" --password "$p" >/dev/null 2>&1; then
    log "registered $host with Supervisor"
    creds_registered=$((creds_registered + 1))
  else
    log "WARN: Supervisor refused $host registration — continuing with other hosts"
  fi
done
if [ "$creds_registered" -eq 0 ]; then
  fail "Supervisor rejected ALL hosts in $GHCR_CREDS_FILE_FOUND" 3
fi

# --- 4. install + start ga_manager ------------------------------------
# `install` is idempotent — if already installed, Supervisor returns
# the "already installed" response which `ha` treats as exit 0 on
# recent versions. We follow with `start` which is also idempotent.
#
# Verify-after-install is required for the same reason as the store-add
# pattern above: Supervisor reports success once the install JOB is
# accepted, but the actual image pull + container create happens
# asynchronously. We check addons_installed() (= the addon's reported
# version is non-null) until it succeeds, with the same exp-backoff
# budget as store-add (= same kind of supervisor-side race).

addons_installed() {
  # ha addons info --raw-json reports a "version" KEY for every store-
  # known addon, valued null until the addon is actually installed.
  # Check the VALUE, not just key presence.
  # The raw reply is kept in $last_addon_info so the caller can tell
  # "does not exist" (store not loaded) from "known, not installed".
  last_addon_info=$("$HA_CLI" addons info "$1" --no-progress --raw-json 2>&1 || true)
  _v=$(printf '%s' "$last_addon_info" \
        | "$JQ_CLI" -r '(.data.version // .version // empty)' 2>/dev/null || true)
  [ -n "${_v}" ] && [ "${_v}" != "null" ]
}

last_addon_info=""
addon_missing_from_store() {
  # True only when Supervisor says the add-on DOES NOT EXIST (= not in any
  # loaded store), as opposed to "known but not installed" (version null)
  # or any other failure. Only this case gets the store-recovery ladder.
  # Checks the reply of the LAST addons_installed call (no extra API call).
  printf '%s' "$last_addon_info" | grep -q -i 'does not exist'
}

wait_supervisor_ready() {
  _deadline=$(( $(date +%s) + SUPERVISOR_WAIT_S ))
  while :; do
    if "$HA_CLI" supervisor info --raw-json 2>/dev/null | grep -q '"result":"ok"'; then
      return 0
    fi
    [ "$(date +%s)" -ge "$_deadline" ] && return 1
    sleep "$SUPERVISOR_POLL_INTERVAL"
  done
}

# Store-recovery ladder (Odoo #1337). Measured on a canary
# (BOSv1.5.2-rc2, 2026-10-23): a power cut during the first store clone
# left repository.json zero-length; Supervisor reset + re-cloned the store
# but never loaded its add-ons into memory — `ha store reload` and
# `ha addons reload` did not help, `ha supervisor restart` did. So, when
# the add-on does not exist although the store is registered:
#   rung 1: store reload, re-check
#   rung 2: ONE Supervisor restart per run, wait until it answers, re-check
# then fall through to the normal install retries. Never when the add-on
# exists (install failing for another reason keeps the old behaviour).
store_ladder_done=0
store_recovery_ladder() {
  store_ladder_done=1
  if ! addon_repo_present; then
    log "WARN: $GA_MANAGER_SLUG does not exist AND vibe_addons store is not registered — no store recovery, plain retry"
    return 0
  fi
  log "WARN: $GA_MANAGER_SLUG does not exist although vibe_addons store is registered — rung 1: ha store reload"
  "$HA_CLI" store reload --no-progress >/dev/null 2>&1 || \
    log "WARN: rung 1: store reload returned non-zero"
  addons_installed "$GA_MANAGER_SLUG" || true
  if ! addon_missing_from_store; then
    log "WARN: rung 1: $GA_MANAGER_SLUG visible after store reload — continuing install"
    return 0
  fi
  log "WARN: rung 1: $GA_MANAGER_SLUG still does not exist after store reload — rung 2: restarting Supervisor (once per run)"
  "$HA_CLI" supervisor restart --no-progress >/dev/null 2>&1 || \
    log "WARN: rung 2: supervisor restart returned non-zero (it may drop the connection) — waiting for it anyway"
  if wait_supervisor_ready; then
    log "WARN: rung 2: Supervisor answers again after restart"
  else
    log "WARN: rung 2: Supervisor did not answer within ${SUPERVISOR_WAIT_S}s after restart — continuing retries"
  fi
  addons_installed "$GA_MANAGER_SLUG" || true
  if addon_missing_from_store; then
    log "WARN: rung 2: $GA_MANAGER_SLUG STILL does not exist after Supervisor restart — continuing install retries"
  else
    log "WARN: rung 2: $GA_MANAGER_SLUG visible after Supervisor restart — continuing install"
  fi
}

wait_ready "before install"
log "installing $GA_MANAGER_SLUG — with retry"
addon_ready=0
for pre_sleep in $BACKOFF_SEQUENCE; do
  if [ "$pre_sleep" -gt 0 ]; then
    log "waiting ${pre_sleep}s before retry..."
    sleep "$pre_sleep"
  fi
  "$HA_CLI" addons install "$GA_MANAGER_SLUG" >/dev/null 2>&1 || true
  if addons_installed "$GA_MANAGER_SLUG"; then
    log "$GA_MANAGER_SLUG installed + verified"
    addon_ready=1
    break
  fi
  if [ "$store_ladder_done" -eq 0 ] && addon_missing_from_store; then
    store_recovery_ladder
    "$HA_CLI" addons install "$GA_MANAGER_SLUG" >/dev/null 2>&1 || true
    if addons_installed "$GA_MANAGER_SLUG"; then
      log "$GA_MANAGER_SLUG installed + verified (after store recovery)"
      addon_ready=1
      break
    fi
  fi
  log "addon not yet installed — retrying"
done
[ "$addon_ready" -eq 1 ] || fail "ga_manager install failed/un-verifiable after 6 attempts (~8 min)" 4

# --- 3a. force protected=false on ga_manager (BEFORE the first start) --
# Why: Supervisor's install default is `protected=true`, which silently
# omits the docker.sock bind that ga_manager's self-update path needs
# (`docker exec hassio_cli ha addons update <slug>`; see ha-operating-system
# memory:bug_k49_supervisor_docker_sock_missing). ga_manager is part of the
# OS image, so it is operator-trusted.
#
# ORDER MATTERS: container mounts are fixed at container CREATION. The flag
# is therefore set after install and BEFORE the first `addons start`, so the
# first container already gets the bind. A POST that is never accepted means
# NO start (exit 9): starting would create a protected container that only a
# later recreate can fix.
#
# The socket is ALWAYS verified after start (also when the flag was already
# false: the container may predate it). Unbound -> bounded restart retry ->
# re-check; still unbound -> exit 7, marker never written.
#
# Container name: Supervisor 2026.10+ names add-on containers app_<slug>,
# older ones addon_<slug>. gm_container resolves app_ first, then addon_.
gm_container() {
  for _n in "app_${GA_MANAGER_SLUG}" "addon_${GA_MANAGER_SLUG}"; do
    if "$DOCKER_CLI" container inspect --format '{{.Id}}' "$_n" >/dev/null 2>&1; then
      echo "$_n"
      return 0
    fi
  done
  return 1
}
gm_docker_sock_state() {
  _cn=$(gm_container) || { echo nocontainer; return 0; }
  mounts=""
  mounts=$("$DOCKER_CLI" inspect "$_cn" \
             --format '{{range .Mounts}}{{println .Destination}}{{end}}' 2>/dev/null) \
    || { echo uninspectable; return 0; }
  if printf '%s\n' "$mounts" | grep -qxE '/(var/)?run/docker\.sock'; then
    echo present
  else
    echo absent
  fi
}
gm_post_unprotect() {
  # The $SUPERVISOR_TOKEN in the single-quoted sh -c body expands inside hassio_cli.
  # shellcheck disable=SC2016
  "$DOCKER_CLI" exec hassio_cli sh -c 'wget -qO- \
      --header="Authorization: Bearer $SUPERVISOR_TOKEN" \
      --header="Content-Type: application/json" \
      --post-data="{\"protected\": false}" \
      "http://supervisor/addons/'"$GA_MANAGER_SLUG"'/security"' \
      2>/dev/null | grep -q '"result":"ok"'
}
_prot=$("$HA_CLI" addons info "$GA_MANAGER_SLUG" --no-progress --raw-json 2>/dev/null \
        | "$JQ_CLI" -r '(if .data.protected != null then .data.protected else .protected end | if . == null then "unknown" else tostring end)' 2>/dev/null || true)
if [ "$_prot" = "false" ]; then
  log "$GA_MANAGER_SLUG already has protected=false"
else
  log "disabling protected mode on $GA_MANAGER_SLUG before its first start (= enables docker_api self-update path)"
  retry_cmd "protected=false POST" "$GM_POST_MAX_S" "$GM_POST_STEP_S" gm_post_unprotect \
    || fail "could not disable protected mode on $GA_MANAGER_SLUG within ${GM_POST_MAX_S}s — NOT starting it (a protected container would have no docker.sock); systemd retries" 9
  log "protected=false applied"
fi

wait_ready "before first start"
log "starting $GA_MANAGER_SLUG"
retry_cmd "ga_manager start" "$GM_START_MAX_S" "$GM_START_STEP_S" \
    "$HA_CLI" addons start "$GA_MANAGER_SLUG" \
  || fail "ga_manager start failed (slug=$GA_MANAGER_SLUG) within ${GM_START_MAX_S}s" 4

# --- 3a'. verify docker.sock on the running container (always) ---------
# A container that is not visible yet right after start is transient.
retry_cmd "container visibility" "$GM_VISIBLE_WAIT_S" "$GM_VISIBLE_STEP_S" gm_container || true
_sock=$(gm_docker_sock_state)
case "$_sock" in
  present)
    log "$GA_MANAGER_SLUG: docker.sock is bound — step 3a verified"
    ;;
  nocontainer)
    fail "neither app_${GA_MANAGER_SLUG} nor addon_${GA_MANAGER_SLUG} exists after start (waited ${GM_VISIBLE_WAIT_S}s) — cannot verify docker.sock" 6
    ;;
  uninspectable)
    fail "cannot inspect the $GA_MANAGER_SLUG container to verify docker.sock" 6
    ;;
  *)
    log "WARN: $GA_MANAGER_SLUG has NO docker.sock bound (container created before protected=false) — restarting it (retry while Supervisor is not ready)"
    retry_cmd "restart of $GA_MANAGER_SLUG" "$GM_RESTART_MAX_S" "$GM_RESTART_STEP_S" \
        "$HA_CLI" addons restart "$GA_MANAGER_SLUG" \
      || fail "restart of $GA_MANAGER_SLUG never succeeded within ${GM_RESTART_MAX_S}s — docker.sock stays unbound" 7
    retry_cmd "container visibility" "$GM_VISIBLE_WAIT_S" "$GM_VISIBLE_STEP_S" gm_container || true
    _sock=$(gm_docker_sock_state)
    if [ "$_sock" = "present" ]; then
      log "$GA_MANAGER_SLUG: docker.sock bound after restart"
    else
      fail "$GA_MANAGER_SLUG restarted but docker.sock is still not bound (state=$_sock)" 7
    fi
    ;;
esac

# --- 4a. wait for HA Core ready ---------------------------------------
# Absorbs ga-ha-init's wait. We want ga-bootstrap to exit only once
# the device is fully reachable end-to-end — that's the contract a
# fleet-manager status probe relies on. Best-effort: if Core never
# reports "running" within HA_CORE_WAIT_S we log + continue (do NOT
# fail). The marker still gets written so a later boot isn't blocked
# on this same wait — converge keeps an eye on Core health after that.
log "waiting for HA Core to report state=running (up to ${HA_CORE_WAIT_S}s)"
deadline=$(( $(date +%s) + HA_CORE_WAIT_S ))
# Best-effort wait must not push the run past the unit timeout.
[ "$deadline" -le "$T_END" ] || deadline=$T_END
while :; do
  state=$("$HA_CLI" core info --no-progress --raw-json 2>/dev/null \
            | "$JQ_CLI" -r '.data.state // ""' 2>/dev/null || true)
  if [ "$state" = "running" ]; then
    log "HA Core state=running"
    break
  fi
  if [ "$(date +%s)" -ge "$deadline" ]; then
    log "WARN: HA Core never reported running within ${HA_CORE_WAIT_S}s (last state=${state:-unknown}) — continuing"
    break
  fi
  sleep "$HA_CORE_POLL_INTERVAL"
done

# --- 5. touch marker --------------------------------------------------
if [ "$DRY_RUN" = "1" ]; then
  log "dry-run: skipping marker write"
  exit 0
fi
mkdir -p "$(dirname "$MARKER")"
: > "$MARKER"
chmod 0644 "$MARKER"
log "wrote marker $MARKER — bootstrap done"
